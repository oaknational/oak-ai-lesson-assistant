{
  "name": "@oakai/core",
  "version": "1.0.0",
  "description": "Core functionality for the project",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "admin": "open http://localhost:8288",
    "check": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules",
    "doppler:run:dev": "doppler run -c dev --silent",
    "doppler:run:prd": "doppler run -c prd --silent",
    "doppler:run:stg": "doppler run -c stg --silent",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --config jest.config.mjs",
    "type-check": "tsc --noEmit"
  },
  "prettier": "@oakai/prettier-config",
  "eslintConfig": {
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "extends": "@oakai/eslint-config"
  },
  "dependencies": {
    "@hubspot/api-client": "^14.1.2",
    "@oakai/db": "workspace:*",
    "@oakai/logger": "workspace:*",
    "@slack/web-api": "^8.3.0",
    "@upstash/ratelimit": "^2.0.1",
    "@upstash/redis": "^1.40.0",
    "@vercel/functions": "^3.10.5",
    "@vercel/oidc": "^4.0.5",
    "cloudinary": "^2.11.0",
    "google-auth-library": "^11.3.2",
    "murmurhash": "^2.0.1",
    "openai": "^7.47.0",
    "openapi-fetch": "^0.17.0",
    "tiny-invariant": "^1.3.1",
    "ts-dedent": "^2.2.0",
    "ts-md5": "^2.0.1",
    "ts-node": "^10.9.2",
    "unique-names-generator": "^4.7.1",
    "untruncate-json": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@oakai/prettier-config": "workspace:*",
    "@oakai/test-support": "workspace:*",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5"
  }
}
