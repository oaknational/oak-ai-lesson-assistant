{
  "name": "@oakai/api",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules",
    "lint": "eslint .",
    "test": "jest --config jest.config.mjs",
    "test:coverage": "COLLECT_TEST_COVERAGE=true jest --config jest.config.mjs --coverage",
    "test:file": "jest --config jest.config.mjs --runTestsByPath TEST_FILEPATH",
    "test:seq": "jest --config jest.config.mjs --verbose --runInBand",
    "type-check": "tsc --noEmit"
  },
  "prettier": "@oakai/prettier-config",
  "eslintConfig": {
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "extends": "@oakai/eslint-config"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/nextjs": "7.9.18",
    "@oakai/aila": "workspace:*",
    "@oakai/core": "workspace:*",
    "@oakai/db": "workspace:*",
    "@oakai/exports": "workspace:*",
    "@oakai/gsuite": "workspace:*",
    "@oakai/lesson-adapters": "workspace:*",
    "@oakai/logger": "workspace:*",
    "@oakai/teaching-materials": "workspace:*",
    "@trpc/server": "11.19.0",
    "cloudinary": "^2.11.0",
    "next": "16.4.2",
    "remeda": "^2.54.1",
    "superjson": "^2.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@oakai/eslint-config": "workspace:*",
    "@oakai/prettier-config": "workspace:*",
    "@oakai/test-support": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=8"
  }
}
