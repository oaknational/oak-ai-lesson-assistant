{
  "name": "@oakai/teaching-materials",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --config jest.config.mjs",
    "test:coverage": "COLLECT_TEST_COVERAGE=true jest --config jest.config.mjs --coverage",
    "test:file": "jest --config jest.config.mjs --runTestsByPath TEST_FILEPATH",
    "test:seq": "jest --config jest.config.mjs --verbose --runInBand",
    "type-check": "tsc --noEmit"
  },
  "prettier": "@oakai/prettier-config",
  "eslintConfig": {
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "extends": "@oakai/eslint-config"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.18",
    "@oakai/core": "workspace:*",
    "@oakai/logger": "workspace:*",
    "@oaknational/oak-curriculum-schema": "1.61.0",
    "@sentry/nextjs": "^10.29.0",
    "ai": "^4.1.00",
    "dotenv-cli": "^11.0.0",
    "openai": "^6.45.0",
    "serialize-error": "^13.0.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@oakai/eslint-config": "workspace:*",
    "@oakai/prettier-config": "workspace:*",
    "@oakai/test-support": "workspace:*",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=8"
  }
}
