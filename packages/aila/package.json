{
  "name": "@oakai/aila",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules",
    "lint": "eslint .",
    "test": "pnpm with-env jest --config jest.config.mjs",
    "test:seq": "pnpm with-env jest --config jest.config.mjs --verbose --runInBand",
    "test-coverage": "COLLECT_TEST_COVERAGE=true pnpm with-env jest --config jest.config.mjs --coverage",
    "test-file": "pnpm with-env jest --config jest.config.mjs --runTestsByPath TEST_FILEPATH",
    "type-check": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "prettier": "@oakai/prettier-config",
  "eslintConfig": {
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "extends": "@oakai/eslint-config"
  },
  "dependencies": {
    "@anatine/zod-mock": "^3.13.4",
    "@clerk/nextjs": "7.9.18",
    "@faker-js/faker": "^9.4.0",
    "@oakai/core": "workspace:*",
    "@oakai/db": "workspace:*",
    "@oakai/exports": "workspace:*",
    "@oakai/logger": "workspace:*",
    "@oakai/rag": "workspace:*",
    "@sentry/nextjs": "^10.29.0",
    "@vercel/kv": "^0.2.2",
    "@vercel/oidc": "^4.0.2",
    "ai": "4.0.20",
    "american-british-english-translator": "^0.2.1",
    "cloudinary": "^2.11.0",
    "dedent": "^1.5.3",
    "dotenv-cli": "^11.0.0",
    "immer": "^11.2.6",
    "jsonrepair": "^3.8.0",
    "openai": "^6.45.0",
    "openapi-fetch": "^0.17.0",
    "p-limit": "^7.2.0",
    "remeda": "^1.29.0",
    "superjson": "^1.9.1",
    "tiny-invariant": "^1.3.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@oakai/eslint-config": "workspace:*",
    "@oakai/prettier-config": "workspace:*",
    "@oakai/test-support": "workspace:*",
    "@pollyjs/adapter-fetch": "^6.0.6",
    "@pollyjs/adapter-node-http": "^6.0.6",
    "@pollyjs/core": "^6.0.6",
    "@pollyjs/persister-fs": "^6.0.6",
    "@types/dedent": "^0.7.2",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "setup-polly-jest": "^0.11.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=8"
  }
