{
  "name": "@oakai/aila",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules",
    "lint": "eslint .",
    "test": "pnpm with-env jest --config jest.config.mjs",
    "test:seq": "pnpm with-env jest --config jest.config.mjs --verbose --runInBand",
    "test-coverage": "COLLECT_TEST_COVERAGE=true pnpm with-env jest --config jest.config.mjs --coverage",
    "test-file": "pnpm with-env jest --config jest.config.mjs --runTestsByPath TEST_FILEPATH",
    "type-check": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "prettier": "@oakai/prettier-config",
  "eslintConfig": {
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "extends": "@oakai/eslint-config"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.23",
    "@oakai/core": "workspace:*",
    "@oakai/db": "workspace:*",
    "@oakai/exports": "workspace:*",
    "@oakai/logger": "workspace:*",
    "@oakai/rag": "workspace:*",
    "@sentry/nextjs": "^11.10.0",
    "@vercel/oidc": "^4.0.5",
    "american-british-english-translator": "^0.2.1",
    "cloudinary": "^2.11.0",
    "cohere-ai": "^8.3.0",
    "dedent": "^1.5.3",
    "dotenv-cli": "^11.1.0",
    "immer": "^11.2.9",
    "js-tiktoken": "^1.0.21",
    "openai": "^7.47.0",
    "openapi-fetch": "^0.17.0",
    "remeda": "^2.58.0",
    "tiny-invariant": "^1.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@oakai/eslint-config": "workspace:*",
    "@oakai/prettier-config": "workspace:*",
    "@oakai/test-support": "workspace:*",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=8"
  }
}
