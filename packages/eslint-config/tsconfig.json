{
  "compilerOptions": {
    // baseUrl and moduleResolution "node" are deprecated in TypeScript 6
    // and removed in 7. Replace them before upgrading to 7
    "ignoreDeprecations": "6.0",
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "./src"
  },
  "include": [
    "*.ts",
    "src/*.ts",
    "eslint.config.old",
    "src/rules.mjs",
    "src/index.mjs",
    "src/ignores.mjs"
  ],
  "exclude": ["node_modules", "dist"]
}
