{
  "compilerOptions": {
    // baseUrl and moduleResolution "node" are deprecated in TypeScript 6
    // and removed in 7. Replace them before upgrading to 7
    "ignoreDeprecations": "6.0",
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext"],
    "outDir": "./dist-tests",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,
    "types": ["jest", "node"]
  },
  "include": ["**/*.test.ts"],
  "exclude": ["node_modules"]
}
