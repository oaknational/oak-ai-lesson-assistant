{
  "name": "@oakai/nextjs",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "next build",
    "build:dev": "pnpm with-env next build",
    "build-storybook": "dotenv -e ../../.env -- storybook build",
    "check": "tsc --noEmit",
    "chromatic": "pnpm with-env pnpm dlx chromatic",
    "clean": "rm -rf .next .turbo node_modules",
    "dev": "FORCE_COLOR=1 SENTRY_SUPPRESS_TURBOPACK_WARNING=1 pnpm with-env next dev --port 2525 --turbo | pino-pretty -C",
    "dev:sentry": "FORCE_COLOR=1 pnpm with-env next dev --port 2525 | pino-pretty -C",
    "dev-trace-deprecation": "NODE_OPTIONS=\"--trace-deprecation\" next dev --port 2525 | pino-pretty -C",
    "generate-posthog-survey-types": "pnpm with-env pnpm tsx ./scripts/generate-posthog-survey-types.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-debug": "eslint --debug .",
    "start": "next start",
    "storybook": "dotenv -e ../../.env -- storybook dev -p 6006 --no-open",
    "test": "pnpm with-env jest --config jest.config.mjs",
    "test:seq": "pnpm with-env jest --config jest.config.mjs --verbose --runInBand --no-cache",
    "test-coverage": "COLLECT_TEST_COVERAGE=true pnpm with-env jest --config jest.config.mjs --coverage",
    "test-e2e": "pnpm with-env playwright test",
    "test-e2e-ui": "pnpm with-env playwright test --ui",
    "test-e2e-ui-built": "PORT=4848 pnpm with-env playwright test --ui",
    "test-e2e-ui-serve": "pnpm build && pnpm start --port 4848 --turbo",
    "type-check": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "prettier": "@oakai/prettier-config",
  "eslintConfig": {
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "extends": "@oakai/eslint-config"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.159",
    "@clerk/nextjs": "7.9.22",
    "@clerk/testing": "^2.2.52",
    "@datadog/datadog-api-client": "^1.27.0",
    "@headlessui/react": "^2.2.10",
    "@mux/mux-player-react": "^3.14.1",
    "@oakai/aila": "workspace:*",
    "@oakai/api": "workspace:*",
    "@oakai/core": "workspace:*",
    "@oakai/db": "workspace:*",
    "@oakai/eslint-config": "workspace:*",
    "@oakai/exports": "workspace:*",
    "@oakai/lesson-adapters": "workspace:*",
    "@oakai/logger": "workspace:*",
    "@oakai/prettier-config": "workspace:*",
    "@oakai/rag": "workspace:*",
    "@oakai/teaching-materials": "workspace:*",
    "@oaknational/oak-components": "^3.24.0",
    "@oaknational/oak-consent-client": "^2.1.0",
    "@oaknational/oak-curriculum-schema": "2.17.0",
    "@portabletext/react": "^8.0.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/themes": "^1.0.0",
    "@sanity/client": "^8.12.0",
    "@sentry/nextjs": "^11.9.0",
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/react": "^16.0.0",
    "@trpc/client": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "@uidotdev/usehooks": "^2.4.1",
    "@vercel/functions": "^3.10.4",
    "@vercel/oidc": "^4.0.4",
    "ai": "^7.0.155",
    "american-british-english-translator": "^0.2.1",
    "archiver": "^8.0.0",
    "better-react-mathjax": "3.0.3",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.11.0",
    "fast-json-patch": "^3.1.1",
    "geist": "^1.8.2",
    "gleap": "^11.1.5",
    "jest-transform-stub": "^2.0.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "openai": "^7.45.1",
    "posthog-js": "^1.441.0",
    "posthog-node": "^5.57.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "react-textarea-autosize": "^8.5.3",
    "remark-gfm": "^4.0.0",
    "remeda": "^2.54.1",
    "scroll-into-view-if-needed": "^3.1.0",
    "styled-components": "^6.6.0",
    "svix": "^2.9.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tiny-invariant": "^1.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.0",
    "untruncate-json": "^0.0.1",
    "zod": "4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@oakai/test-support": "workspace:*",
    "@playwright/test": "^1.51.1",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/nextjs": "^10.6.5",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/archiver": "^8.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.6.2",
    "avo": "^3.2.14",
    "dotenv-cli": "^11.0.0",
    "eslint-plugin-storybook": "10.6.5",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "msw": "^3.0.3",
    "msw-storybook-addon": "^3.0.3",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.1.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^3.3.7",
    "ts-jest": "^29.2.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=8"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
